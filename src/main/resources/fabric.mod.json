{
	"schemaVersion": 1,
	"id": "modid",
	"version": "${version}",
	"name": "Anarchy Client",
	"description": "Anarchy Client: fast mining, NoFall and a settings GUI.",
	"authors": [
		"rickkkkkey"
	],
	"contact": {
		"homepage": "https://github.com/rickkkkkey/fastmine",
		"sources": "https://github.com/rickkkkkey/fastmine"
	},
	"license": "CC0-1.0",
	"icon": "assets/modid/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.ExampleMod"
		],
		"client": [
			"com.example.client.ExampleModClient"
		]
	},
	"mixins": [
		"modid.mixins.json",
		{
			"config": "modid.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}